{
  "name": "starters_templates",
  "version": "1.0.0",
  "description": "A collection of quick starter templates",
  "author": "Arnaud B.",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:css": "NODE_ENV=production postcss src/css/styles.css src/css/print.css -d dist/css",
